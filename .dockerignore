# Контекст сборки копируется в образ целиком (COPY в Dockerfile), поэтому здесь
# остаётся только то, что в образе не нужно или сделало бы его зависимым от
# локального состояния машины.
.git
.github
.vscode
*.md
.dotfiles-backup
.dotfiles-venv

# Каталог, куда install_digitwm клонирует и собирает исходники: это результат
# сборки, а не исходный код репозитория.
src/

# Временное и артефакты — в образ не тащим.
.scratch
*.log
*.tmp
__pycache__/
.DS_Store
