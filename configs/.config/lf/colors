# Цвета lf в палитре Digitable — те же значения, что у схемы Vim
# configs/.vim/colors/digitable.vim и у остальных конфигов этого репозитория.
# Палитра и пороги контраста заданы в theme/digitable.flang, сверяет их
# scripts/check-theme.sh: он читает отсюда и SGR-тройки 38;2;R;G;B, и hex
# в комментариях.
#
# Формат — lf: пары «шаблон  значение», «#» начинает комментарий до конца
# строки (doc.md, раздел COLORS). Значение — ANSI SGR; 24-битный цвет
# записывается как 38;2;R;G;B. Файл ищется в ~/.config/lf/colors и читается
# ПОСЛЕ LS_COLORS, поэтому переопределяет его: цвета lf не зависят от того,
# из какой оболочки его запустили.
#
# Порядок сопоставления задаёт сам lf (полный путь -> имя каталога -> тип ->
# имя файла -> расширение -> fi), а не порядок строк здесь.

# ── Типы файлов ────────────────────────────────────────────────────────────
# Роли те же, что в схеме Vim: каталог — Directory (бирюзовый), ссылка —
# Special, битая ссылка — Error, исполняемый — NERDTreeExecFile, обычный
# файл — Normal.

di  01;38;2;0;229;229      # каталог          cyan     #00e5e5  12.74:1
ln  38;2;0;216;255         # ссылка           cyansoft #00d8ff  11.72:1
or  01;38;2;255;91;91      # битая ссылка     red      #ff5b5b   6.59:1
ex  01;38;2;124;255;107    # исполняемый      green    #7cff6b  15.64:1
fi  38;2;245;247;250       # обычный файл     white    #f5f7fa  18.69:1

# Особые узлы файловой системы — роль «объявление» (PreProc в схеме Vim).
pi  38;2;182;92;255        # именованный канал  purple #b65cff  5.70:1
so  38;2;182;92;255        # сокет              purple
bd  01;38;2;182;92;255     # блочное устройство purple
cd  01;38;2;182;92;255     # символьное устр-во purple

# Права, которые стоит заметить, — роль «предупреждение» (WarningMsg).
su  01;38;2;255;138;42     # setuid             orange #ff8a2a  8.52:1
sg  01;38;2;255;138;42     # setgid             orange
tw  01;38;2;255;138;42     # каталог с sticky, доступный на запись всем
ow  01;38;2;255;138;42     # каталог, доступный на запись всем
st  01;38;2;255;138;42     # каталог со sticky

