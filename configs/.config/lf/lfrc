set previewer ~/.config/lf/preview
set cleaner ~/.config/lf/cleaner

# ── Оформление в палитре Digitable ─────────────────────────────────────────
# Цвета имён файлов лежат отдельно, в ~/.config/lf/colors — так устроен сам lf
# (doc.md, разделы CONFIGURATION и COLORS). Здесь остаётся то, что цветом
# именами файлов не задаётся: приглашение, строка под курсором, рамка,
# отметки и сообщения.
#
# Значение каждой опции — ANSI SGR; 24-битный цвет пишется как 38;2;R;G;B
# (текст) и 48;2;R;G;B (фон). Двойные кавычки в lfrc понимают \033.
# Числа — из theme/digitable.flang, сверяет их scripts/check-theme.sh.

# Приглашение: «кто@где» приглушённо, каталог — бирюзой (Directory в схеме
# Vim), имя файла — белым.
set promptfmt "\033[38;2;155;170;184m%u@%h\033[0m:\033[1;38;2;0;229;229m%d\033[0m\033[1;38;2;245;247;250m%f\033[0m"

# Строка под курсором. Своего цвета имени файла она не сохраняет намеренно:
# фон выделения #0f3745 даёт приглушённому #718695 только 3.36:1, то есть
# ниже порога, а белый на нём — 11.84:1. Это тот же ответ, что у схемы Vim
# для «текущей строки списка»: QuickFixLine — white на sel.
set cursoractivefmt "\033[1;38;2;245;247;250;48;2;15;55;69m"
# В панели родителя курсор тише: muted на том же фоне — 5.35:1.
set cursorparentfmt "\033[38;2;155;170;184;48;2;15;55;69m"
# В предпросмотре каталога — подчёркивание без цвета, как у lf по умолчанию.
set cursorpreviewfmt "\033[4m"

# Рамка. Без drawbox её нет вовсе, и borderfmt был бы мёртвой строкой.
# Цвет — border #15566a: это линия, а не текст, 2.46:1 ниже порога намеренно
# (тот же цвет у VertSplit в схеме Vim).
set drawbox true
set borderfmt "\033[38;2;21;86;106m"

# Номера строк (видны при `set number`): subtle — как LineNr, 5.30:1;
# под курсором — бирюзовый жирный, как CursorLineNr.
set numberfmt "\033[38;2;113;134;149m"
set numbercursorfmt "\033[1;38;2;0;229;229m"

# Сообщение об ошибке — ErrorMsg схемы Vim: фон красный, текст цвета фона
# буфера, 6.59:1.
set errorfmt "\033[1;38;2;5;8;13;48;2;255;91;91m"

# Отметки. Цвета взяты по смыслу, а не по вкусу: «получилось» — зелёный,
# «не получилось» — красный, «выбрано» — бирюзовый (PmenuSel), «отмечено
# зрительно» — жёлтый (IncSearch), метка — фиолетовый.
set selectfmt "\033[1;38;2;5;8;13;48;2;0;229;229m"
set copyfmt   "\033[1;38;2;5;8;13;48;2;124;255;107m"
set cutfmt    "\033[1;38;2;5;8;13;48;2;255;91;91m"
set visualfmt "\033[1;38;2;5;8;13;48;2;255;194;71m"
set tagfmt    "\033[1;38;2;182;92;255m"

# Меню (`:` и подсказка клавиш): подложка Pmenu, выбранная строка — PmenuSel.
set menufmt       "\033[38;2;245;247;250;48;2;11;17;26m"
set menuheaderfmt "\033[1;38;2;255;194;71;48;2;11;17;26m"
set menuselectfmt "\033[1;38;2;5;8;13;48;2;0;229;229m"
