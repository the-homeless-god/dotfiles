[gpg]
	format = ssh
[user]
	email = zimtir@mail.ru
	name = Marat Zimnurov

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    side-by-side = true
    features = side-by-side line-numbers decorations
    # Тема лежит в этом же репозитории: configs/.config/bat/themes/digitable.tmTheme.
    # delta читает темы из ~/.config/bat/themes после `bat cache --build` —
    # install-tools.sh делает и то и другое.
    syntax-theme = digitable
    # Фоны — по формуле палитры «цвет 12% поверх фона», усиление 30%:
    # те же значения, что у DiffAdd/DiffDelete/DiffText в схеме Vim.
    plus-style = syntax "#132618"
    minus-style = syntax "#231216"
    plus-emph-style = syntax "#295229"
    minus-emph-style = syntax "#502124"

[delta "decorations"]
    commit-decoration-style = bold "#ffc247" box ul
    file-decoration-style = none
    hunk-header-decoration-style = "#00e5e5" box ul

[delta "line-numbers"]
    line-numbers-left-style = "#00e5e5"
    line-numbers-right-style = "#00e5e5"
    line-numbers-minus-style = "#ff5b5b"
    line-numbers-plus-style = "#7cff6b"

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
